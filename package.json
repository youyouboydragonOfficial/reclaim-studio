{
  "name": "reclaim-studio",
  "version": "0.1.3",
  "description": "A focused Windows file recovery utility for deleted photos, videos and documents.",
  "main": "main.js",
  "author": "OpenAI",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^32.2.7",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.reclaimstudio.app",
    "productName": "Reclaim Studio",
    "compression": "maximum",
    "asar": true,
    "files": [
      "**/*",
      "!outputs/**",
      "!work/**",
      "!dist/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "requestedExecutionLevel": "requireAdministrator",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
